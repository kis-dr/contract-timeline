[{"code":"000430","date":"2026-09-03","company_name":"대원강업","article_title":"'밸류업' 공시 상장사 756곳…시총 83% 참여","briefing":"대원강업이 오늘 2.85% 상승하면서 4,335원에 마감했어요. 주가 상승의 주요 원인은 기업가치 제고 계획 공시가 늘어나면서 시장의 긍정적인 반응을 이끌어낸 것으로 보입니다. 특히 대원강업도 이 공시에 참여하면서 투자자들의 기대감이 높아진 것 같습니다.","content_url":"https://news.tf.co.kr/read/economy/2361573.htm","publisher":"더팩트","polarity":null,"change_rate":2.847,"created_at":"2026-09-03T14:15:08.000000"},{"code":"000430","date":"2026-09-02","company_name":"대원강업","article_title":null,"briefing":"대원강업의 주가가 4215.0원으로 -3.5469107551487413% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-3.5469,"created_at":"2026-09-02"},{"code":"000430","date":"2026-09-01","company_name":"대원강업","article_title":null,"briefing":"대원강업의 주가가 4370.0원으로 -0.45558086560364464% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-0.4556,"created_at":"2026-09-01"},{"code":"000430","date":"2026-08-31","company_name":"대원강업","article_title":null,"briefing":"대원강업의 주가가 4390.0원으로 -1.57% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-1.57,"created_at":"2026-08-31"},{"code":"000430","date":"2026-08-28","company_name":"대원강업","article_title":"\"PBR 2~3배 올리겠다\"…기업가치 제고 공시 4배 급증","briefing":"대원강업의 주가가 4.69% 상승하여 4,460원에 마감되었습니다. 이 상승은 기업가치 제고 계획에 대한 기대감이 반영된 것으로 보입니다. 특히 PBR 개선 목표를 제시한 기업들이 증가하면서 투자자들의 긍정적인 반응을 이끌어낸 것으로 분석됩니다.","content_url":"https://biz.sbs.co.kr/article_hub/20000330195","publisher":"SBS Biz","polarity":null,"change_rate":4.69,"created_at":"2026-08-23T09:42:00.000000"},{"code":"000430","date":"2026-08-24","company_name":"대원강업","article_title":"\"PBR 개선\" 기업가치 제고 계획 공시↑…주요 내용 살펴보니","briefing":"대원강업의 주가가 0.38% 상승하여 4,010원에 마감되었습니다. 이와 같은 소폭 상승은 기업가치 제고 계획에 대한 기대감이 반영된 것으로 보입니다. 그러나 주가 변동이 크지 않았던 만큼, 시장의 반응은 제한적이었던 것으로 판단됩니다.","content_url":"https://www.yna.co.kr/view/AKR20260821182700