[{"code":"001420","date":"2026-08-14","company_name":"태원물산","article_title":"시장 살린다며 '무더기 상폐' 초읽기…투자자 보호는 '뒷전'","briefing":"태원물산의 주가가 22.39% 하락하여 2,010원에 마감되었습니다. 이번 하락은 금융당국의 상장폐지 기준 강화로 인해 관리종목으로 지정된 영향으로 보입니다. 이에 따라 부실기업 퇴출이 본격화될 것이라는 우려가 투자 심리를 위축시킨 것으로 분석됩니다.","content_url":"https://news.tf.co.kr/read/economy/2354189.htm","publisher":"더팩트","polarity":null,"change_rate":-22.39,"created_at":"2026-08-14T10:54:00.000000"},{"code":"001420","date":"2026-08-20","company_name":"태원물산","article_title":"부실기업 퇴출 본격화…'동전주 탈출' 나선 상장사, 증시 체질개선 신호탄","briefing":"태원물산의 주가가 1.19% 상승하여 2,125원에 마감되었습니다. 주가 상승은 최근 상장폐지 기준 강화와 관련된 시장의 반응으로 보입니다. 그러나 전반적으로 주가는 큰 변동 없이 안정세를 유지하고 있으며, 관리종목 지정에 대한 우려가 여전히 존재합니다.","content_url":"http://www.fnnews.com/news/202608131559469679","publisher":"파이낸셜뉴스","polarity":"중립","change_rate":1.19,"created_at":"2026-08-13T16:03:00.000000"},{"code":"001420","date":"2026-08-18","company_name":"태원물산","article_title":"동전주·시총미달 상폐후보…관리종목 30종 신규지정","briefing":"태원물산의 주가가 4.48% 상승하여 2,100원에 마감되었습니다. 이 상승은 최근 상장폐지 기준 강화로 인해 관리종목으로 지정된 기업들이 주식병합 등을 통해 기준 회복에 나서고 있다는 소식에 긍정적인 반응을 얻은 것으로 보입니다. 이러한 변화는 태원물산의 주가에 긍정적인 영향을 미쳤을 것으로 예상됩니다.","content_url":"https://www.mt.co.kr/stock/2026/08/12/2026081217463586758","publisher":"머니투데이","polarity":"중립","change_rate":4.48,"created_at":"2026-08-12T17:53:00.000000"},{"code":"001420","date":"2026-08-12","company_name":"태원물산","article_title":null,"briefing":"태원물산의 주가가 2590.0원으로 -7.17% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-7.17,"created_at":"2026-08-12"},{"code":"001420","date":"2026-08-11","company_name":"태원물산","article_title":null,"briefing":"태원물산의 주가가 2790.0원으로 5.68% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":5.68,"created_at":"2026-08-11"},{"code":"001420","date":"2026-08-10","company_name":"태원물산","article_title":null,"briefing":"태원물산의 주가가 2640.0원으로 5.39% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴