[{"code":"005820","date":"2026-08-24","company_name":"원림","article_title":"시원섭섭, 떠나는 여름 풍경 ①담양 명옥헌 원림","briefing":"원림의 주가가 0.20% 상승하여 15,210원에 마감되었습니다. 이와 같은 소폭 상승은 시장의 전반적인 흐름에 따른 것으로 보이며, 특별한 이슈는 확인되지 않았습니다. 그러나 최근 여름철 관광지로서의 매력도가 높아지고 있다는 점은 긍정적인 요소로 작용할 수 있습니다.","content_url":"https://www.newsis.com/view/NISX20260823_0003758874","publisher":"뉴시스","polarity":"중립","change_rate":0.2,"created_at":"2026-08-24T06:00:00.000000"},{"code":"005820","date":"2026-08-14","company_name":"원림","article_title":"원림, 상반기 매출 430억…영업익 26% 증가","briefing":"원림의 주가가 2.68% 상승하여 15,350원에 마감되었습니다. 주가 상승은 상반기 매출과 영업이익이 증가한 실적 개선에 기인한 것으로 보입니다. 그러나 주가 변동률이 3% 미만으로 큰 변화는 없었으며, 주요 이슈로는 의료기기와 벤처투자 등 사업 다각화가 긍정적인 영향을 미쳤습니다.","content_url":"https://www.joongang.co.kr/article/25453400","publisher":"중앙일보","polarity":"긍정","change_rate":2.68,"created_at":"2026-08-14T15:14:00.000000"},{"code":"005820","date":"2026-08-13","company_name":"원림","article_title":null,"briefing":"원림의 주가가 14950.0원으로 -1.19% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-1.19,"created_at":"2026-08-13"},{"code":"005820","date":"2026-08-12","company_name":"원림","article_title":null,"briefing":"원림의 주가가 15130.0원으로 3.84% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":3.84,"created_at":"2026-08-12"},{"code":"005820","date":"2026-08-11","company_name":"원림","article_title":null,"briefing":"원림의 주가가 14570.0원으로 0.55% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.55,"created_at":"2026-08-11"},{"code":"005820","date":"2026-08-10","company_name":"원림","article_title":null,"briefing":"원림의 주가가 14490.0원으로 2.11% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":2.11,"created_at":"2026-08-10"},{"code":"005820","date":"2026-08-07","company_name":"원림","article_title":null,"briefing"