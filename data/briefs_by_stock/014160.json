[{"code":"014160","date":"2026-08-12","company_name":"대영포장","article_title":"나 떨고있니 ?… 동전주 23개, 오늘 종가에 상폐 갈린다","briefing":"대영포장의 주가가 2.74% 하락하여 711.0원에 마감되었습니다. 이번 하락은 관리종목 지정 우려로 인해 투자자들의 심리가 위축된 것으로 분석됩니다. 주가가 1000원을 회복하지 못할 경우 관리종목으로 지정될 가능성이 커지면서 불안감이 확산된 것으로 보입니다.","content_url":"https://www.munhwa.com/article/11608989","publisher":"문화일보","polarity":null,"change_rate":-2.74,"created_at":"2026-08-12T11:42:00.000000"},{"code":"014160","date":"2026-08-07","company_name":"대영포장","article_title":"'1941년생 현역 CEO’ 비결은 '국선도'…\"건강한 마음은 리더십의 출발\"","briefing":"대영포장의 주가는 변동이 없으며 708.0원에 마감되었습니다. 주가가 크게 변동하지 않았지만, 권혁홍 신대양제지 대표의 경영 철학과 기업가 정신에 대한 기사로 인해 시장의 관심이 집중된 것으로 보입니다. 이러한 이슈는 대영포장과 직접적인 관련은 없으나, 제조업 전반에 대한 긍정적인 시각을 불러일으킬 수 있습니다.","content_url":"https://www.edaily.co.kr/news/newspath.asp?newsid=03299686645545024","publisher":"이데일리","polarity":null,"change_rate":0.0,"created_at":"2026-08-07T06:25:00.000000"},{"code":"014160","date":"2026-08-06","company_name":"대영포장","article_title":null,"briefing":"대영포장의 주가가 708.0원으로 0.0% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.0,"created_at":"2026-08-06"},{"code":"014160","date":"2026-08-05","company_name":"대영포장","article_title":null,"briefing":"대영포장의 주가가 708.0원으로 1.29% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":1.29,"created_at":"2026-08-05"},{"code":"014160","date":"2026-08-04","company_name":"대영포장","article_title":null,"briefing":"대영포장의 주가가 699.0원으로 0.72% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.72,"created_at":"2026-08-04"},{"code":"014160","date":"2026-08-03","company_name":"대영포장","article_title":null,"briefing":"대영포장의 주가가 694.0원으로 0.87% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.87,"created_at":"2026-08-03"},{"code":"014160","date":"2026