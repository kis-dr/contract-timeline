[{"code":"063760","date":"2026-09-17","company_name":"이엘피","article_title":"산업부, '디스플레이의 날' 개최⋯유공자 36명 포상","briefing":"이엘피가 오늘 -1.30% 하락하면서 정규장 마감 기준 2,270원에 거래를 마쳤어요. 주가 하락의 직접적인 이유는 없지만, 디스플레이 산업 관련 행사와 정부의 지원 계획이 발표된 점이 주요 이슈로 작용했을 것으로 보입니다. 이러한 발표가 시장에 긍정적인 영향을 미칠 수 있지만, 이엘피의 주가는 다소 부진한 모습을 보였어요.","content_url":"http://www.inews24.com/view/2006809","publisher":"아이뉴스24","polarity":null,"change_rate":-1.3043,"created_at":"2026-09-17T15:19:00.000000"},{"code":"063760","date":"2026-09-16","company_name":"이엘피","article_title":"프로이천 \"올해 매출 10% 성장 전망\"...신규 품목 하반기 실적 반영","briefing":"이엘피가 오늘 0.0% 변동없음으로 정규장 마감 기준 2,300원에 거래를 마쳤어요. 주가는 큰 변화가 없었지만, 프로이천의 매출 성장 전망과 신규 품목에 대한 기대감이 있었던 것으로 보입니다. 다만, 이엘피와 직접적인 관련이 있는 이슈는 없었던 것 같습니다.","content_url":"https://zdnet.co.kr/view/?no=20260916104553","publisher":"지디넷코리아","polarity":null,"change_rate":0.0,"created_at":"2026-09-16T10:51:00.000000"},{"code":"063760","date":"2026-09-15","company_name":"이엘피","article_title":"HB솔루션·프로이천, '국책과제' 올레도스 검사방법 특허 등록...수요기업 삼성D","briefing":"이엘피가 오늘 0.88% 상승하면서 정규장 마감 기준 2,300원에 거래를 마쳤어요. 주가 변동이 크지 않았지만, 올레도스 검사방법 특허 등록 소식이 긍정적인 영향을 미쳤던 것으로 보입니다. 특히, 삼성디스플레이와의 수요 연계가 기대되면서 향후 성장 가능성에 대한 기대감이 커지고 있어요.","content_url":"https://zdnet.co.kr/view/?no=20260915014629","publisher":"지디넷코리아","polarity":null,"change_rate":0.8772,"created_at":"2026-09-15T01:51:00.000000"},{"code":"063760","date":"2026-09-08","company_name":"이엘피","article_title":"\"K-뷰티는 이제 시작\"…서경배·윤상현·허민호 K뷰티 수장 총출동(종합)","briefing":"이엘피의 주가가 4.43% 하락하여 2,265원에 마감되었습니다. 이번 하락은 K-뷰티 관련 행사에서의 긍정적인 논의에도 불구하고, 시장의 전반적인 불안감이 반영된 것으로 보입니다. 주요 이슈로는 글로벌 화장품 규제 변화에 대한 논의가 있었으나, 이엘피에 대한 직접적인 긍정적 소식은 없었습니다.","content_url":"https://www.news1.kr/industry/distribution/6282419","publisher":"뉴스1","polarity":null,"change_rate":-4.43,"created_at":"2026-09-07T15:58:00.000000"},{"code":"063760","date":"2026-09-07","company_name":"이엘피","article_title":null,"briefing":"이엘피의 주가가 2370.0원으로 0.851063829787234% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_