[{"code":"068330","date":"2026-08-24","company_name":"일신바이오","article_title":null,"briefing":"일신바이오의 주가가 1018.0원으로 2.83% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":2.83,"created_at":"2026-08-24"},{"code":"068330","date":"2026-08-18","company_name":"일신바이오","article_title":"100개 기업 상폐 공포 덮쳤다…“내 주식 관리종목 지정될라” 개미 초비상","briefing":"일신바이오의 주가가 0.30% 하락하여 987원에 마감되었습니다. 주가 하락의 주요 원인은 최근 관리종목 지정 우려가 커지고 있기 때문입니다. 1000원 미만의 주가가 지속되면서 관리종목으로 지정될 가능성이 높아지고 있어 투자자들의 심리가 위축된 것으로 보입니다.","content_url":"https://www.mk.co.kr/article/12129162","publisher":"매일경제","polarity":null,"change_rate":-0.3,"created_at":"2026-08-16T22:51:00.000000"},{"code":"068330","date":"2026-08-20","company_name":"일신바이오","article_title":"동전주·시총미달 39개 관리종목 지정…상장폐지 공포 현실화","briefing":"일신바이오의 주가가 4.08% 상승하여 1,020원에 마감되었습니다. 이 상승은 최근 관리종목 지정 우려에도 불구하고 시장에서 긍정적인 반응을 얻은 것으로 보입니다. 그러나 여전히 상장폐지 요건 강화와 관련된 불안 요소가 존재하여 주의가 필요합니다.","content_url":"http://www.inews24.com/view/1995454","publisher":"아이뉴스24","polarity":null,"change_rate":4.08,"created_at":"2026-08-16T17:08:00.000000"},{"code":"068330","date":"2026-08-13","company_name":"일신바이오","article_title":"동전주·시총미달 36곳 무더기 '관리종목'…퇴출 본격화(종합)","briefing":"일신바이오의 주가가 2.20% 하락하여 978원에 마감되었습니다. 이번 하락은 관리종목 지정에 따른 우려가 반영된 것으로 보입니다. 시가총액 기준 강화로 인해 관리종목으로 지정된 종목이 증가하면서 투자 심리가 위축된 것으로 분석됩니다.","content_url":"https://www.news1.kr/finance/general-stock/6257297","publisher":"뉴스1","polarity":null,"change_rate":-2.2,"created_at":"2026-08-12T18:18:00.000000"},{"code":"068330","date":"2026-08-12","company_name":"일신바이오","article_title":null,"briefing":"일신바이오의 주가가 1000.0원으로 4.6% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":4.6,"created_at":"2026-08-12"},{"code":"068330","date":"2026-08-11","company_name":"일신바이오","article_title":null,"briefing":"일신바이오의 주가가 956.0원으로 0.53% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":