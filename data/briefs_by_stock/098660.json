[{"code":"098660","date":"2026-09-04","company_name":"에스티오","article_title":"에스티오, 소액주주 대상 자기주식 현물 차등배당 추진","briefing":"에스티오가 오늘 1.06% 하락하면서 1,584원에 마감했어요. 이번 하락은 자기주식을 활용한 현물 차등배당 추진 소식이 영향을 미친 것으로 보입니다. 최대주주를 제외한 일반 주주를 대상으로 한 배당 정책이 발표되었지만, 시장에서는 부정적인 반응을 보인 것 같습니다.","content_url":"https://www.etnews.com/20260904000094","publisher":"전자신문","polarity":"중립","change_rate":-1.0618,"created_at":"2026-09-04T10:38:00.000000"},{"code":"098660","date":"2026-09-03","company_name":"에스티오","article_title":"“대주주 빼고 배당”… 에스티오가 꺼낸 자사주 카드","briefing":"에스티오가 오늘 4.30% 하락하면서 1,601원에 마감했어요. 대주주가 배당에서 제외된 자사주를 활용한 배당 정책 발표가 부정적인 영향을 미친 것으로 보입니다. 적자를 기록한 상황에서 배당을 거른 것이 처음이라는 점도 투자자들에게 우려를 안겼습니다.","content_url":"https://www.etnews.com/20260902000404","publisher":"전자신문","polarity":"긍정","change_rate":-4.3036,"created_at":"2026-09-02T16:46:00.000000"},{"code":"098660","date":"2026-08-28","company_name":"에스티오","article_title":"상법 개정 후 섬유·의류 상장사 주주환원 확대…배당성향 상향·차등배당 검토","briefing":"에스티오의 주가가 2.41% 상승하여 1,741원에 마감되었습니다. 그러나 이 상승세는 상대적으로 큰 변동이 아니며, 주요 이슈로는 섬유·의류 업종에서 주주환원 정책이 구체화되고 있다는 점이 있습니다. 차등배당 계획이 제시되면서 투자자들의 관심이 높아지고 있는 상황입니다.","content_url":"https://isplus.com/article/view/isp202608270099","publisher":"일간스포츠","polarity":null,"change_rate":2.41,"created_at":"2026-08-27T16:03:00.000000"},{"code":"098660","date":"2026-08-26","company_name":"에스티오","article_title":"상법 개정 후 섬유·의류 상장사 주주환원 확대…배당성향 상향·차등배당 검토","briefing":"에스티오의 주가가 2.11% 하락하여 1,623원에 마감되었습니다. 이 하락세는 상법 개정 이후 배당 정책에 대한 불확실성이 영향을 미친 것으로 보입니다. 특히 섬유·의류 업종에서 배당성향 상향과 차등배당 검토가 이루어지고 있지만, 에스티오의 구체적인 계획이 부족하여 투자자들의 우려가 커진 것으로 분석됩니다.","content_url":"https://economist.co.kr/article/view/ecn202608260034","publisher":"이코노미스트","polarity":null,"change_rate":-2.11,"created_at":"2026-08-26T14:25:00.000000"},{"code":"098660","date":"2026-08-25","company_name":"에스티오","article_title":null,"briefing":"에스티오의 주가가 1658.0원으로 -0.3% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-0.3,"