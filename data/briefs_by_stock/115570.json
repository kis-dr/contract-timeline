[{"code":"115570","date":"2026-09-02","company_name":"스타플렉스","article_title":"[서울데이터랩] 코스닥, 장 초반 802.80 출발 후 796.34까지 밀려…미 증시 약세·중동 긴장에 급락","briefing":"스타플렉스가 오늘 10.74% 하락하면서 2,660원에 마감했어요. 미국 증시의 약세와 중동 긴장 고조가 투자 심리를 악화시킨 것으로 보입니다. 특히 외국인과 기관의 동반 매도가 주가 하락에 큰 영향을 미쳤습니다.","content_url":"https://www.seoul.co.kr/news/economy/securities/2026/09/02/20260902500034","publisher":"서울신문","polarity":null,"change_rate":-10.7383,"created_at":"2026-09-02T09:32:00.000000"},{"code":"115570","date":"2026-08-26","company_name":"스타플렉스","article_title":"영업익 73억인데 상폐 될 판…시총 잣대에 흑자기업 ‘한숨’","briefing":"스타플렉스의 주가가 2.18% 상승하여 2,580원에 마감되었습니다. 주가 상승의 주요 원인은 코스닥 상장폐지 기준 강화에 따른 시장의 관심이 집중된 것으로 보입니다. 그러나 영업이익률이 양호한 상황에도 불구하고 시가총액 기준 미달로 인한 우려가 여전히 존재합니다.","content_url":"https://www.edaily.co.kr/News/Read?newsId=05707206645550928&mediaCodeNo=257&utm_medium=referral&utm_campaign=news_syndication&utm_content=original_article","publisher":"이데일리","polarity":null,"change_rate":2.18,"created_at":"2026-08-25T23:32:00.000000"},{"code":"115570","date":"2026-08-25","company_name":"스타플렉스","article_title":"자본 크고 흑자 나도 상장폐지 위기...이억원 금융위원장 “미세조정 검토”","briefing":"스타플렉스의 주가가 2.64% 상승하여 2,525원에 마감되었습니다. 이와 같은 상승세는 최근 금융위원회의 미세조정 검토 소식과 관련이 있을 수 있습니다. 그러나 주가 변동이 크지 않았던 만큼, 시장의 전반적인 반응이 더디게 나타난 것으로 보입니다.","content_url":"https://biz.heraldcorp.com/article/10851433","publisher":"헤럴드경제","polarity":null,"change_rate":2.64,"created_at":"2026-08-25T13:22:00.000000"},{"code":"115570","date":"2026-08-24","company_name":"스타플렉스","article_title":null,"briefing":"스타플렉스의 주가가 2460.0원으로 0.41% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.41,"created_at":"2026-08-24"},{"code":"115570","date":"2026-08-21","company_name":"스타플렉스","article_title":null,"briefing":"스타플렉스의 주가가 2450.0원으로 -1.01% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-1.01,"created_at":"2026-08-21"},{"code":"115570","date":"20