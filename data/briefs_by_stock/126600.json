[{"code":"126600","date":"2026-08-20","company_name":"BGF에코머티리얼즈","article_title":"BGF에코머티리얼즈, 비지에프에코솔루션 주식 80만주 추가취득","briefing":"BGF에코머티리얼즈의 주가가 1.22% 하락하여 2,835원에 마감되었습니다. 이번 하락은 비지에프에코솔루션의 주식 80만주를 추가 취득하는 결정이 시장에서 부정적으로 해석된 것으로 보입니다. 주식 취득이 풋옵션 행사에 따른 것이라는 점은 긍정적이지만, 투자자들의 우려가 반영된 결과로 판단됩니다.","content_url":"https://view.asiae.co.kr/article/2026081917411011461","publisher":"아시아경제","polarity":"긍정","change_rate":-1.22,"created_at":"2026-08-19T17:41:00.000000"},{"code":"126600","date":"2026-08-19","company_name":"BGF에코머티리얼즈","article_title":"반도체 환호에 묻힌 소부장 비명… “中, 원자재 문턱 높이고 있다”","briefing":"BGF에코머티리얼즈의 주가가 2.38% 하락하여 2,870원에 마감되었습니다. 이 하락세는 반도체 산업의 호황 속에서도 소재 자립화에 대한 우려가 커지고 있는 상황과 관련이 있습니다. 특히, 중국의 원자재 수출 규제가 지속되면서 소재 공급망에 대한 불안감이 증대되고 있습니다.","content_url":"https://www.chosun.com/economy/industry-company/2026/08/18/ECZST7WLQBAXJLMCWZV33GFFCA/?utm_medium=referral&utm_campaign=naver-news","publisher":"조선일보","polarity":null,"change_rate":-2.38,"created_at":"2026-08-18T00:46:00.000000"},{"code":"126600","date":"2026-08-18","company_name":"BGF에코머티리얼즈","article_title":null,"briefing":"BGF에코머티리얼즈의 주가가 2940.0원으로 -1.34% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-1.34,"created_at":"2026-08-18"},{"code":"126600","date":"2026-08-14","company_name":"BGF에코머티리얼즈","article_title":null,"briefing":"BGF에코머티리얼즈의 주가가 2980.0원으로 0.68% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.68,"created_at":"2026-08-14"},{"code":"126600","date":"2026-08-13","company_name":"BGF에코머티리얼즈","article_title":null,"briefing":"BGF에코머티리얼즈의 주가가 2960.0원으로 -1.66% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-1.66,"created_at":"2026-08-13"},{"code":"126600","date":"2026-08-12","company_name":"BGF에코머티리얼즈","article_title":null,"briefing":"BGF에코머티리얼즈의 주가가 3010.0원으로 0.0% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직