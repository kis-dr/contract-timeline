[{"code":"217820","date":"2026-08-21","company_name":"원익피앤이","article_title":"원익홀딩스 자사주 54억에 산 호라이즌…돈은 어디서 났나 [기업분석 원익그룹]","briefing":"원익피앤이의 주가가 5.79% 하락하여 1,840원에 마감되었습니다. 이번 하락은 전기차 충전 솔루션 관련 협약 체결 소식에도 불구하고, 시장의 우려가 반영된 것으로 보입니다. 특히 원익홀딩스의 자사주 매입과 관련된 의문이 투자자들에게 불안감을 주었을 가능성이 있습니다.","content_url":"http://www.joseilbo.com/news/news_read.php?uid=574193&class=17","publisher":"조세일보","polarity":"중립","change_rate":-5.79,"created_at":"2026-08-21T07:03:08.000000"},{"code":"217820","date":"2026-08-19","company_name":"원익피앤이","article_title":"원익피앤이·씨엘모빌리티, '충전 연동형 EV 플릿 통합관제' 공동 개발 협약","briefing":"원익피앤이의 주가가 1.44% 하락하여 1,918원에 마감되었습니다. 이 하락세는 특별한 외부 요인 없이 진행된 것으로 보이며, 최근 전기차 충전 솔루션 관련 협약 체결 소식이 있었지만 주가에 긍정적인 영향을 미치지 못한 것으로 판단됩니다. 향후 협약의 실증 결과가 주가에 미치는 영향이 주목됩니다.","content_url":"https://magazine.hankyung.com/business/article/202608199512b","publisher":"한경비즈니스","polarity":"중립","change_rate":-1.44,"created_at":"2026-08-19T13:08:00.000000"},{"code":"217820","date":"2026-08-18","company_name":"원익피앤이","article_title":null,"briefing":"원익피앤이의 주가가 1946.0원으로 -3.42% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-3.42,"created_at":"2026-08-18"},{"code":"217820","date":"2026-08-14","company_name":"원익피앤이","article_title":null,"briefing":"원익피앤이의 주가가 2015.0원으로 0.8% 상승하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":0.8,"created_at":"2026-08-14"},{"code":"217820","date":"2026-08-13","company_name":"원익피앤이","article_title":null,"briefing":"원익피앤이의 주가가 1999.0원으로 -0.79% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-0.79,"created_at":"2026-08-13"},{"code":"217820","date":"2026-08-12","company_name":"원익피앤이","article_title":null,"briefing":"원익피앤이의 주가가 2015.0원으로 -2.18% 하락하였습니다. 이러한 변동에 대한 공식적인 뉴스나 발표는 아직 확인되지 않았습니다.","content_url":null,"publisher":null,"polarity":null,"change_rate":-2.18,"created_at